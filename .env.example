# Скопируйте в .env и подставьте свои значения. Настоящий .env не коммитим.

# Наша база: очередь артикулов.
QUEUE_DSN=postgresql://пользователь:пароль@хост:5427/avito_parser_views
# Источник артикулов, только чтение.
SMART_DSN=postgresql://пользователь:пароль@хост:5402/smart

# Категория, в которой ищем артикул. Регион задаётся здесь же: /all — вся Россия.
CATALOG_PATH=/all/zapchasti_i_aksessuary
