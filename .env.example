# Скопируйте в .env и подставьте свои значения. Настоящий .env не коммитим.

# Наши очереди: артикулы, объявления, связка между ними.
QUEUE_DSN=postgresql://пользователь:пароль@хост:5427/avito_parser_views
# База библиотеки: объявления, продавцы, наблюдения за просмотрами.
AVITO_DSN=postgresql://пользователь:пароль@хост:5424/avito_data
# Источник артикулов, только чтение.
SMART_DSN=postgresql://пользователь:пароль@хост:5402/smart

# Список адресов: строки «хост:порт@логин:пароль», либо json провайдера.
PROXIES=/root/avito_parser_views/proxies.txt

# Категория, в которой ищем артикул. Регион задаётся здесь же: /all — вся Россия.
CATALOG_PATH=/all/zapchasti_i_aksessuary

WORKERS=40
PAGES=100
ATTEMPTS=3
CARDS_THRESHOLD=100
COOLDOWN=900
COOLDOWN_MAX=2400
QUIET_COOLDOWN=60
STALE_AFTER=1800
REFRESH_DAYS=7
